# S3 / Object Storage Configuration (used by /api/project and /api/start)
S3_BUCKET=repl
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_ENDPOINT=https://s3.amazonaws.com

