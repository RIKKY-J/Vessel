# S3 / Object Storage Configuration (used by /api/project and /api/start)
S3_BUCKET=repl
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_ENDPOINT=https://s3.amazonaws.com

# Kubernetes Cluster Configuration (Required for Vercel deployment)
KUBERNETES_SERVICE_HOST=https://your-eks-cluster-endpoint.eks.amazonaws.com
KUBERNETES_SERVICE_TOKEN=your_service_account_token
KUBERNETES_CA_DATA=your_base64_ca_cert

# Optional: Override runner WebSocket endpoint if testing without public DNS
# NEXT_PUBLIC_RUNNER_WS_URL=ws://localhost:3001

